# LLM Configuration
# Set OPENAI_API_KEY to use OpenAI GPT models (e.g., gpt-4o, gpt-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here
MODEL_NAME=gpt-4o-mini
LLM_PROVIDER=openai

# Optional: Set to 'mock' for fully deterministic offline evaluation without API calls
# LLM_PROVIDER=mock

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Open-Meteo API Endpoints (No API key required)
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# Policies Path
SOP_FILE_PATH=policies/sops.yaml
